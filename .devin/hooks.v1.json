{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .devin/hooks/session-start.py",
          "timeout": 30
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .devin/hooks/inject-shell-session-context.py",
          "timeout": 5
        }
      ]
    }
  ]
}
